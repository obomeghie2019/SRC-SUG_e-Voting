# MySQL (recommended here)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/evoting
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/evoting

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
WEB_JWT_MINUTES=60
MOBILE_JWT_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# Used by seed.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# ---------- Voter sign-in: location + one-time code ----------
LOCATION_REQUIRED=true
# Optional campus geofence (radius 0 = off). Centre in decimal degrees, radius in metres.
GEOFENCE_LAT=0
GEOFENCE_LNG=0
GEOFENCE_RADIUS_M=0

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT=3
OTP_SEND_WINDOW_MINUTES=10
SESSION_MINUTES=15
VOTE_TOKEN_MINUTES=30

# LOCAL TESTING ONLY: print codes in the API console instead of sending them. Set false in production.
OTP_DEV_MODE=true
# true only when running behind your own nginx/proxy (so the voter IP is read from X-Forwarded-For)
TRUST_PROXY=false

# ---------- Email (SMTP) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------- SMS: termii | africastalking | twilio (leave empty to switch SMS off) ----------
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
DEFAULT_COUNTRY_CODE=234

# Uploaded images (school logo, candidate photos); UPLOAD_DIR defaults to backend/uploads
MAX_UPLOAD_MB=2
