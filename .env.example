# Used by docker-compose.yml  (copy to .env and edit)

# Database. Use letters and digits only (no @ : / # characters).
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
WEB_JWT_MINUTES=60
MOBILE_JWT_MINUTES=120

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# First admin account (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Set to --demo for sample candidates and 5 demo voters (PINs appear in the api_web logs)
SEED_ARGS=
