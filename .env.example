# Used by docker-compose.yml  (copy to .env and edit)

# Database. Use letters and digits only (no @ : / # characters).
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
WEB_JWT_MINUTES=60
MOBILE_JWT_MINUTES=120

# Origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# First admin account (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!

# Set to --demo for sample candidates and 5 demo voters (DEMO/001 ... DEMO/005)
SEED_ARGS=

# ---- Voter sign-in: location + one-time code (email or SMS) ----
LOCATION_REQUIRED=true
GEOFENCE_LAT=0
GEOFENCE_LNG=0
GEOFENCE_RADIUS_M=0
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT=3
OTP_SEND_WINDOW_MINUTES=10
# LOCAL TESTING ONLY: codes are printed in the api_web logs instead of being sent. Set false for a real election.
OTP_DEV_MODE=true

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# SMS: termii | africastalking | twilio (empty = SMS off)
SMS_PROVIDER=
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=
DEFAULT_COUNTRY_CODE=234

# Uploaded images (school logo, candidate photos)
# UPLOAD_DIR defaults to backend/uploads (Docker: the 'uploads' volume)
MAX_UPLOAD_MB=2
